/* 全局样式：浅色主题，与 Web 版视觉一致 */
page {
  background: #f5f6f8;
  color: #1a1f29;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1f29;
  margin-bottom: 20rpx;
  display: flex;
  align-items: baseline;
}

.card-title .hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #8d96a4;
  margin-left: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #8d96a4;
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: #5b6472;
}

.divider {
  height: 1rpx;
  background: #eef0f4;
  margin: 20rpx 0;
}

/* 状态点 */
.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c4cad3;
  margin-right: 12rpx;
}
.dot.on {
  background: #12a150;
  box-shadow: 0 0 0 6rpx rgba(18, 161, 80, 0.12);
}

/* 标签 */
.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: #5b6472;
}
.badge.on {
  background: #e9f8ef;
  color: #0b7a3d;
}
.badge.off {
  background: #fdeceb;
  color: #a71f16;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f3f7;
  color: #5b6472;
}
.tag.ble {
  background: #eef3ff;
  color: #2a5bd7;
}
.tag.zigbee {
  background: #e9f8ef;
  color: #0b7a3d;
}

.empty {
  text-align: center;
  color: #a8b0bc;
  font-size: 24rpx;
  padding: 40rpx 0;
}
