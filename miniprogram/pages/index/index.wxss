.statusbar {
  display: flex;
  align-items: center;
  padding: 4rpx 8rpx 20rpx;
}

.status-text {
  font-size: 24rpx;
  color: #5b6472;
}

.status-host {
  margin-left: auto;
  font-size: 20rpx;
  color: #a8b0bc;
}

.stats {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #eef0f4;
}
.stat:last-child {
  border-right: none;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #1a1f29;
}

.stat-label {
  font-size: 22rpx;
  color: #8d96a4;
  margin-top: 6rpx;
}

.item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}
.item:last-child {
  border-bottom: none;
}

.item.tap:active {
  background: #fafbfc;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1f29;
  display: flex;
  align-items: center;
}

.item-sub {
  margin-top: 8rpx;
}

.chip {
  font-size: 22rpx;
  color: #2a5bd7;
  background: #eef3ff;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.arrow {
  color: #c4cad3;
  font-size: 30rpx;
  line-height: 1;
}

.err {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a71f16;
}
