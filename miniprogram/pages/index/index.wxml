<view class="page">

  <view class="statusbar">
    <view class="dot {{wsReady ? 'on' : ''}}"></view>
    <text class="status-text">{{wsText}}</text>
    <text class="status-host mono">{{apiHost}}</text>
  </view>

  <view class="stats">
    <view class="stat">
      <text class="stat-num">{{stats.gw}}</text>
      <text class="stat-label">在线网关</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.dev}}</text>
      <text class="stat-label">在线设备</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.cmd}}</text>
      <text class="stat-label">执行中命令</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">网关<text class="hint">{{gateways.length}}</text></view>
    <block wx:for="{{gateways}}" wx:key="id">
      <view class="item">
        <view class="row">
          <view class="item-name"><view class="dot {{item.online ? 'on' : ''}}"></view>{{item.name}}</view>
          <text class="badge {{item.online ? 'on' : 'off'}}">{{item.online ? '在线' : '离线'}}</text>
        </view>
        <view class="row item-sub">
          <text class="mono">{{item.id}}</text>
          <text class="muted">固件 {{item.fw}}</text>
        </view>
        <view class="row item-sub">
          <text class="muted">心跳 {{item.ago}}</text>
        </view>
      </view>
    </block>
    <view wx:if="{{!gateways.length}}" class="empty">暂无网关</view>
  </view>

  <view class="card">
    <view class="card-title">设备<text class="hint">{{devices.length}}</text></view>
    <block wx:for="{{devices}}" wx:key="id">
      <view class="item tap" data-id="{{item.id}}" bindtap="goDevice">
        <view class="row">
          <view class="item-name"><view class="dot {{item.online ? 'on' : ''}}"></view>{{item.name}}</view>
          <text class="tag {{item.proto}}">{{item.proto}}</text>
        </view>
        <view class="row item-sub">
          <text class="chip">{{item.keyText}}</text>
          <text class="muted">{{item.online ? '在线' : '离线'}} · {{item.ago}}</text>
        </view>
        <view class="row item-sub">
          <text class="mono">{{item.id}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </block>
    <view wx:if="{{!devices.length}}" class="empty">暂无设备</view>
  </view>

  <view wx:if="{{errText}}" class="err">连接错误：{{errText}}</view>
</view>
